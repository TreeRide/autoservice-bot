# =============================================================================
# Service Bot · Environment template
# Copy this file to `.env` and fill in real values. Secrets that should NOT
# live in .env (BOT_TOKEN, GEMINI_API_KEY) are passed via the process
# environment (Devin Secrets, systemd EnvironmentFile, k8s Secret, etc.).
# =============================================================================

# --- Process-only secrets (DO NOT put real values here) ----------------------
# Telegram bot token, obtained from @BotFather.
# Set in shell: `export BOT_TOKEN=...`  or via Devin Secrets.
# BOT_TOKEN=__set_via_process_env__

# Google Gemini API key for AI diagnostics + tech-passport OCR.
# GEMINI_API_KEY=__set_via_process_env__

# --- Public-facing config (safe to commit / share) ---------------------------
# Public HTTPS URL of the FastAPI Mini App backend.
# In dev — a `cloudflared quick-tunnel` URL (rotates on every restart).
# In prod — a stable domain pointing to the FastAPI service on :8000.
WEBAPP_URL=https://your-tunnel.trycloudflare.com

# Comma-separated Telegram user IDs that should receive admin role on first
# DB init. Used only when the `admins` table is empty; subsequent admins
# are promoted from the CRM.
ADMIN_BOOTSTRAP_IDS=000000000

# Optional: override SQLite DB path (default = service_bot.db at repo root).
# DATABASE_URL=sqlite+aiosqlite:///service_bot.db
